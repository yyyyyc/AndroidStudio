<?xml version="1.0" encoding="utf-8"?>
<!-- The OpenAI key (secrets.xml) never leaves the phone. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secrets.xml" />
    </device-transfer>
</data-extraction-rules>
